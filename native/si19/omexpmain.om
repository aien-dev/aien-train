note SPDX-License-Identifier: AGPL-3.0-only
note aien-train#24 ORIG-1 driver. stdin: one mode byte, then the allow-list (4096 bytes),
note then omexp-v1 records to end of input. Mode I: admit the file and print the
note dataset identity, family counts and the deterministic baselines per partition and
note core class (contract s.7). Mode G: generate the SYNTHETIC fixture (seed, count from
note the next 16 bytes) to fd 3 and print its identity. No training, no model here.
note Exit: 64 bad mode, 66 dataset refused, 67 unauthorized or revoked, 74 I/O.
global OM uchar 1
global OB uchar 16
global OE ulong 16
text OKV "status="
text OREC "records="
text OFNV "data_fnv="
text OALW "allow="
text OFAM "family_"
text OSTA "static_core"
text OPT "part="
text OCO " core="
text OSEP " "
text OEQ "="
text ONL2 "\n"
text ONM0 "n"
text ONM1 "oracle"
text ONM2 "rule"
text ONM3 "reference"
text ONM4 "static"
text ONM5 "retrieval"
text ONM6 "rule_top1"
text ONM7 "retrieval_top1"
text OREF "SELECT dataset refused status=-"
text OUNA "SELECT dataset not authorized status=-"
text OGEN "fixture_bytes="

fn onl to void
w = write 1 ONL2 0 1
end

fn oread n ulong to ulong
note Read exactly up to n bytes of records into RB; returns the count (stops at EOF).
o = ulong 0
while lt o n bound 999999
r = read 0 RB o sub n o
if lt r 0
exit 74
end
if eq r 0
ret o
end
o = add o ulong r
end
ret o
end

fn olist to ulong
note The allow-list block: 4096 bytes, zero padded; returns the used length.
o = ulong 0
while lt o 4096 bound 4096
r = read 0 LB o sub 4096 o
if lt r 0
exit 74
end
if eq r 0
ret o
end
o = add o ulong r
end
n = ulong 0
for i ulong 4096
if ne get LB i 0
n = add i 1
end
end
ret n
end

fn okey k ulong to void
if eq k 0
w = write 1 ONM0 0 len ONM0
end
if eq k 1
w = write 1 ONM1 0 len ONM1
end
if eq k 2
w = write 1 ONM2 0 len ONM2
end
if eq k 3
w = write 1 ONM3 0 len ONM3
end
if eq k 4
w = write 1 ONM4 0 len ONM4
end
if eq k 5
w = write 1 ONM5 0 len ONM5
end
if eq k 6
w = write 1 ONM6 0 len ONM6
end
if eq k 7
w = write 1 ONM7 0 len ONM7
end
end

fn oacc k ulong v ulong to void
put OE k add get OE k v
end

fn onearm r ulong to ulong
a = oxbest oxnear r
if oxcand r a
ret a
end
ret 0
end

fn obaseone r ulong s ulong to void
oacc 0 1
b = oxbest r
oacc 1 oxcost r b
a = oxrule r
oacc 2 oxcost r a
if eq a b
oacc 6 1
end
oacc 3 oxcost r 0
oacc 4 oxcost r s
a = onearm r
oacc 5 oxcost r a
if eq a b
oacc 7 1
end
end

fn obase part ulong core ulong to void
note Baseline totals over one partition and core class into OE: 0 n, 1 oracle, 2 rule,
note 3 reference, 4 best static, 5 retrieval, 6 rule top-1 hits, 7 retrieval top-1 hits.
for i ulong 8
put OE i 0
end
s = oxstatic core
for r ulong get RC 0
if and eq oxpart r part eq oxcore r core
obaseone r s
end
end
end

fn oshow part ulong core ulong to void
obase part core
w = write 1 OPT 0 len OPT
wnum part
w = write 1 OCO 0 len OCO
wnum core
for k ulong 8
w = write 1 OSEP 0 1
okey k
w = write 1 OEQ 0 1
wnum get OE k
end
onl
end

fn oinspect to void
n = olist
c = oread 524288
s = oxload c
if lt s 0
w = write 1 OREF 0 len OREF
wnum ulong neg long s
onl
exit 66
end
a = oxallow n get RC 2
if lt a 0
w = write 1 OUNA 0 len OUNA
wnum ulong neg long a
onl
exit 67
end
w = write 1 OKV 0 len OKV
wnum 0
onl
w = write 1 OALW 0 len OALW
wnum ulong a
onl
w = write 1 OREC 0 len OREC
wnum get RC 0
onl
w = write 1 OFNV 0 len OFNV
wnum get RC 2
onl
for f ulong 5
w = write 1 OFAM 0 len OFAM
wnum f
w = write 1 OEQ 0 1
wnum get RC add 4 f
onl
end
for k ulong 2
w = write 1 OSTA 0 len OSTA
wnum k
w = write 1 OEQ 0 1
wnum oxstatic k
onl
end
for p ulong 3
for k ulong 2
oshow p k
end
end
end

fn ogen to void
o = ulong 0
while lt o 16 bound 64
r = read 0 OB o sub 16 o
if le r 0
exit 74
end
o = add o ulong r
end
seed = ulong 0
cnt = ulong 0
for i ulong 8
seed = or seed shl ulong get OB i mul i 8
cnt = or cnt shl ulong get OB add 8 i mul i 8
end
n = sxgen seed cnt
o = ulong 0
while lt o n bound 999999
w = write 3 RB o sub n o
if le w 0
exit 74
end
o = add o ulong w
end
w = write 1 OGEN 0 len OGEN
wnum n
onl
w = write 1 OFNV 0 len OFNV
wnum oxfnv n
onl
end

fn main to int
r = read 0 OM 0 1
if ne r 1
exit 64
end
m = get OM 0
if eq m 73
oinspect
ret 0
end
if eq m 71
ogen
ret 0
end
exit 64
end
