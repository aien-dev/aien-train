note SPDX-License-Identifier: AGPL-3.0-only
note Imports unchanged capacity controls for bounded GB/GV and ginit.
fn tgcheck to int
ginit
v = tloss 5
ngrad
for j ulong 4
if not tactive j
if ne get NG add 36 j 0.0f64
ret 60
end
end
end
for i ulong 40
put GV i get NG i
end
for i ulong 40
put NP i add get GB i 0.000001f64
plus = tloss 5
put NP i sub get GB i 0.000001f64
minus = tloss 5
put NP i get GB i
diff = div sub plus minus 0.000002f64
if gt fabs sub diff get GV i 0.00000001f64
ret 61
end
end
for i ulong 40
put NG i get GV i
end
rc = nstep 0.1f64
if ne rc 0
ret 62
end
for i ulong 40
wanted = sub get GB i mul 0.1f64 get GV i
if gt fabs sub get NP i wanted 0.000000000001f64
ret 63
end
z = write 1 GT 0 len GT
if ne z long len GT
ret 80
end
field get TC 0
field i
field bitcast ulong get GB i
field bitcast ulong get GV i
outnum bitcast ulong get NP i
newline
end
ret 0
end
fn tsentin to void
for j ulong 4
put NO j -77.0f64
put NH j -66.0f64
end
end
fn tstay rc int to void
if ne rc 2
exit 41
end
for j ulong 4
if or ne get NO j -77.0f64 ne get NH j -66.0f64
exit 42
end
end
end
fn trefuse to void
put TC 0 0
tclear
put TL 0 1
tsentin
rc = tdecode 1 0 0 0 1 0
tstay rc
rc = tdecode 2 0 0 0 1 1
tstay rc
rc = tdecode 2 0 0 0 0 0
tstay rc
rc = tdecode 2 0 0 0 2 0
tstay rc
rc = tdecode 2 0 2 0 0 0
tstay rc
rc = tdecode 2 0 0 1 1 0
tstay rc
rc = tdecode 2 5 0 0 1 0
tstay rc
put NSH 1 3
rc = tdecode 2 0 0 0 1 0
tstay rc
put NSH 1 4
put NSH 2 31
rc = tdecode 2 0 0 0 1 0
tstay rc
put NSH 2 40
put TC 0 2
rc = tdecode 2 0 0 4 1 0
tstay rc
put TC 0 3
rc = tdecode 2 0 0 0 1 0
tstay rc
put TC 0 0
end
fn ttarget id ulong context ulong to ulong
if eq get TC 0 1
ret tpar id
end
if eq get TC 0 2
ret or and id 12 context
end
ret id
end
fn texact want ulong to void
for j ulong 4
if ne get NO j f64 and shr want j 1
exit 51
end
end
end
fn twitness to void
rc = nconstruct 1
if ne rc 0
exit 52
end
for task ulong 3
put TC 0 task
for id ulong 16
context = ulong 0
if eq task 2
context = and id 3
end
for arm ulong 5
for variant ulong 3
rc = tencode id arm variant
if ne rc 0
exit 53
end
note Destroy all sender-private inputs before receiving the actual byte carrier.
for j ulong 4
put NX j div 0.0f64 0.0f64
put NT j div 0.0f64 0.0f64
end
rc = tdecode 2 arm variant context get TL 0 0
if eq variant 2
if ne rc 2
exit 54
end
else
if ne rc 0
exit 55
end
src = id
if eq variant 1
src = and add id 1 15
end
if or eq arm 0 eq arm 4
texact ttarget src context
end
if and eq task 0 or eq arm 1 eq arm 2
for j ulong 4
p = ulong 0
if ge get NO j 0.5f64
p = 1
end
if ne p and shr src j 1
exit 56
end
end
if ne tabst rc 0
exit 57
end
end
end
end
end
end
end
end
fn tbytes to void
for task ulong 3
put TC 0 task
limit = ulong 15
if eq task 1
limit = 1
end
if eq task 2
limit = 3
end
for value ulong 256
tclear
put WB 0 uchar value
tsentin
rc = tdecode 2 0 0 0 1 0
if gt value limit
tstay rc
else
if ne rc 0
exit 58
end
end
tsentin
rc = tdecode 2 2 0 0 1 0
if gt value 15
tstay rc
else
if ne rc 0
exit 59
end
end
rc = tdecode 2 1 0 0 1 0
if ne rc 0
exit 64
end
end
for pos ulong 4
for value ulong 256
tclear
for j ulong 4
put WB j uchar 48
end
put WB pos uchar value
tsentin
rc = tdecode 2 4 0 0 4 0
if or eq value 48 eq value 49
if ne rc 0
exit 65
end
else
tstay rc
end
end
end
end
end
fn main to int
rc = nshape 1
if ne rc 0
ret rc
end
for task ulong 3
put TC 0 task
rc = tgcheck
if ne rc 0
ret rc
end
end
trefuse
twitness
tbytes
z = write 1 PASS 0 len PASS
if ne z long len PASS
ret 80
end
ret 0
end
