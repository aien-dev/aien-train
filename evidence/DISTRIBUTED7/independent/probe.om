note M20 metadata-v1. Integer metadata only; no allocator or numeric execution.
note ED: schema,dtype,rank,elements,offset,slot,generation,reserved,shape8,stride8.
note ES: live,retired,slot,generation,dtype,elements,reserved,reserved.
note ES is the caller-owned allocator snapshot. It is not untrusted wire input.
global ED ulong 24
global ES ulong 8

fn emshape to int
rank = get ED 2
if gt rank 8
ret -2
end
n = ulong 1
for d ulong rank
size = get ED add 8 d
if eq size 0
ret -3
end
if gt size div 1073741824 n
ret -8
end
n = mul n size
end
if ne get ED 3 n
ret -3
end
ret 0
end

fn emlive slot ulong gen ulong to int
if gt slot 4294967295
ret -5
end
if or ne get ES 0 1 ne get ES 1 0
ret -5
end
if or eq gen 0 ne slot get ES 2
ret -5
end
if ne gen get ES 3
ret -5
end
ret 0
end

fn embounds to int
size = get ES 5
offset = get ED 4
if or eq size 0 gt size 1073741824
ret -8
end
if ge offset size
ret -6
end
note Compare against remaining extent before multiplication, never overflow.
room = sub sub size 1 offset
for d ulong get ED 2
count = sub get ED add 8 d 1
stride = get ED add 16 d
if ne stride 0
if gt count div room stride
ret -6
end
room = sub room mul count stride
end
end
ret 0
end

fn emcheck to int
if or ne get ED 0 1 ne get ED 7 0
ret -1
end
if or ne get ES 6 0 ne get ES 7 0
ret -1
end
dtype = get ED 1
if or lt dtype 1 gt dtype 3
ret -4
end
status = emshape
if ne status 0
ret status
end
status = emlive get ED 5 get ED 6
if ne status 0
ret status
end
if ne dtype get ES 4
ret -4
end
ret embounds
end

fn emrelease slot ulong gen ulong to int
status = emlive slot gen
if ne status 0
ret status
end
note A maximal generation is retired, never wrapped into a valid old handle.
if eq gen 18446744073709551615
put ES 1 1
else
put ES 3 add gen 1
end
put ES 0 0
ret 0
end
note Distributed7 admission-v1; in-process metadata agreement only.
note Consumes the pinned M20 metadata-v1 ED, ES and emcheck implementation.
note Transport authentication, authorization, data movement and sums live elsewhere.
note Roster input: full canonical32-byte machine identities and FAB generation1..u32max.
global d7_ids uchar 512
global d7_gens ulong 16
global d7_rostr uchar 512
global d7_gen ulong 16
global d7_peer uchar 32
global d7_tens uchar 32
global d7_expec uchar 32
global d7_meta ulong 24
global d7_seen uchar 16
note State: epoch,size,next-sequence,mode,deadline-ms,last-now-ms,accepted,operation.
note Mode:0empty,1idle,2collecting,3agreed,4cancelled,5expired.
global d7_state ulong 8

fn d7_idok rank ulong to bool
v = uchar 0
base = mul rank 32
for b ulong 32
v = or v get d7_ids add base b
end
ret ne v 0
end

fn d7_ideq a ulong b ulong to bool
left = mul a 32
right = mul b 32
for i ulong 32
if ne get d7_ids add left i get d7_ids add right i
ret false
end
end
ret true
end

fn d7_copy size ulong to void
for r ulong size
put d7_gen r get d7_gens r
for b ulong 32
p = add mul r 32 b
put d7_rostr p get d7_ids p
end
end
end

fn d7_group epoch ulong size ulong to int
if or eq epoch 0 le epoch get d7_state 0
ret 3
end
if or eq get d7_state 3 2 eq get d7_state 3 3
ret 2
end
if or eq size 0 gt size 16
ret 14
end
for r ulong size
g = get d7_gens r
if or eq g 0 gt g 4294967295
ret 6
end
if not d7_idok r
ret 7
end
for p ulong r
if d7_ideq r p
ret 7
end
end
end
d7_copy size
for i ulong 8
put d7_state i 0
end
put d7_state 0 epoch
put d7_state 1 size
put d7_state 2 1
put d7_state 3 1
ret 0
end

fn d7_shape to int
if ne emcheck 0
ret 9
end
note First contract admits packed row-major tensors only, including scalars.
stride = ulong 1
rank = get ED 2
for i ulong rank
d = sub sub rank i 1
if ne get ED add 16 d stride
ret 9
end
stride = mul stride get ED add 8 d
end
width = ulong 2
if eq get ED 1 1
width = 4
end
note Reuse HTK_OUT_BYTES_MAX=64MiB. No multiplication before the bound check.
if gt get ED 3 div 67108864 width
ret 14
end
ret 0
end

fn d7_tidok to bool
v = uchar 0
for b ulong 32
v = or v get d7_tens b
end
ret ne v 0
end

fn d7_snap to void
for i ulong 24
put d7_meta i get ED i
end
for b ulong 32
put d7_expec b get d7_tens b
end
for r ulong 16
put d7_seen r 0
end
end

fn d7_begin epoch ulong seq ulong now ulong deadline ulong op ulong to int
if ne epoch get d7_state 0
ret 3
end
if ne seq get d7_state 2
ret 4
end
if ne get d7_state 3 1
ret 2
end
note Operation1 is a local sum-agreement tag, not a new HTK1 wire kind.
if ne op 1
ret 1
end
if lt now get d7_state 5
ret 11
end
if le deadline now
ret 10
end
if gt sub deadline now 600000
ret 14
end
rc = d7_shape
if ne rc 0
ret rc
end
if not d7_tidok
ret 9
end
d7_snap
put d7_state 3 2
put d7_state 4 deadline
put d7_state 5 now
put d7_state 6 0
put d7_state 7 op
ret 0
end

fn d7_clock now ulong to int
if eq get d7_state 3 4
ret 13
end
if eq get d7_state 3 5
ret 10
end
if and ne get d7_state 3 2 ne get d7_state 3 3
ret 2
end
if lt now get d7_state 5
ret 11
end
put d7_state 5 now
if ge now get d7_state 4
put d7_state 3 5
ret 10
end
ret 0
end

fn d7_match rank ulong to bool
base = mul rank 32
for b ulong 32
if ne get d7_peer b get d7_rostr add base b
ret false
end
end
ret true
end

fn d7_mcheck to int
rc = d7_shape
if ne rc 0
ret rc
end
for b ulong 32
if ne get d7_tens b get d7_expec b
ret 9
end
end
note Local storage handle, generation and offset intentionally differ by rank.
for i ulong 3
p = add i 1
if ne get ED p get d7_meta p
ret 9
end
end
for d ulong get ED 2
if ne get ED add 8 d get d7_meta add 8 d
ret 9
end
if ne get ED add 16 d get d7_meta add 16 d
ret 9
end
end
ret 0
end

fn d7_offer rank ulong epoch ulong seq ulong gen ulong now ulong op ulong to int
if ne epoch get d7_state 0
ret 3
end
if ne seq get d7_state 2
ret 4
end
rc = d7_clock now
if ne rc 0
ret rc
end
if ge rank get d7_state 1
ret 5
end
if ne gen get d7_gen rank
ret 6
end
if not d7_match rank
ret 7
end
if ne get d7_seen rank 0
ret 8
end
if ne get d7_state 3 2
ret 2
end
if ne op get d7_state 7
ret 1
end
rc = d7_mcheck
if ne rc 0
ret rc
end
put d7_seen rank 1
put d7_state 6 add get d7_state 6 1
if eq get d7_state 6 get d7_state 1
put d7_state 3 3
end
ret 0
end

fn d7_next epoch ulong seq ulong now ulong to int
if ne epoch get d7_state 0
ret 3
end
if ne seq get d7_state 2
ret 4
end
rc = d7_clock now
if ne rc 0
ret rc
end
if or ne get d7_state 3 3 ne get d7_state 6 get d7_state 1
ret 12
end
note Exhausted sequences retire the group; only a higher epoch may restart it.
if eq seq 18446744073709551615
put d7_state 3 4
ret 14
end
put d7_state 2 add seq 1
put d7_state 3 1
put d7_state 6 0
ret 0
end

fn d7_stop epoch ulong seq ulong to int
if ne epoch get d7_state 0
ret 3
end
if ne seq get d7_state 2
ret 4
end
if and ne get d7_state 3 2 ne get d7_state 3 3
ret 2
end
put d7_state 3 4
ret 0
end
note Independent bounded-sequence model for distributed admission source ab17ed3.
global RFail ulong 1
global RCount ulong 1
global RSeen ulong 3
text RGood "D7 independent sequence model PASS\n"
text RBad "D7 independent sequence model FAIL\n"
fn rcheck okay bool to void
put RCount 0 add get RCount 0 1
if not okay
put RFail 0 add get RFail 0 1
end
end
fn rsetup to void
for i ulong 8
put d7_state i 0
put ES i 0
end
for i ulong 24
put ED i 0
end
for i ulong 512
put d7_ids i 0
end
for i ulong 32
put d7_tens i uchar add i 1
end
for r ulong 3
put d7_ids add mul r 32 5 uchar add r 1
put d7_gens r add r 7
put RSeen r 0
end
put ED 0 1
put ED 1 1
put ED 2 0
put ED 3 1
put ED 4 0
put ED 6 99
put ES 0 1
put ES 3 99
put ES 4 1
put ES 5 1
rcheck eq d7_group 99 3 0
rcheck eq d7_begin 99 1 100 200 1 0
end
fn roffer rank ulong now ulong to int
for i ulong 32
put d7_peer i get d7_ids add mul rank 32 i
end
ret d7_offer rank 99 1 add rank 7 now 1
end
fn rtrial encoding ulong to void
rsetup
unique = ulong 0
for step ulong 4
rank = rem encoding 3
encoding = div encoding 3
want = int 0
if ne get RSeen rank 0
want = 8
else
unique = add unique 1
put RSeen rank 1
end
rcheck eq roffer rank add 101 step want
rcheck eq get d7_state 6 unique
end
if eq unique 3
rcheck eq d7_next 99 1 110 0
rcheck eq get d7_state 2 2
else
rcheck eq d7_next 99 1 110 12
rcheck eq get d7_state 2 1
end
end
fn main to int
for trial ulong 81
rtrial trial
end
rsetup
rcheck eq roffer 0 101 0
rcheck eq d7_next 99 1 100 11
rcheck eq get d7_state 6 1
rcheck eq d7_next 99 1 200 10
rcheck eq get d7_state 3 5
rcheck eq roffer 1 201 10
rcheck eq get d7_state 6 1
rsetup
rcheck eq roffer 0 101 0
rcheck eq d7_stop 99 1 0
rcheck eq roffer 1 102 13
rcheck eq get d7_state 6 1
if ne get RFail 0 0
w = write 1 RBad 0 len RBad
ret 1
end
w = write 1 RGood 0 len RGood
ret 0
end
