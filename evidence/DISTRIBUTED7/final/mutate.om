note Exact-source native mutation builder for distributed7 qualification only.
note stdin: one ASCII mode0..4 followed by source. Refuse unmatched/stale source.
text m0 "if not d7_match rank\nret 7\nend\n"
text r0 "if not d7_tidok\nret 7\nend\n"
text m1 "if eq get d7_state 6 get d7_state 1\n"
text r1 "if le get d7_state 6 get d7_state 1\n"
text m2 "if ne seq get d7_state 2\nret 4\nend\n"
text r2 "if eq seq 0\nret 4\nend\n"
text m3 "if ne get ED p get d7_meta p\n"
text r3 "if ne get ED p get ED p\n"
text m4 "if ge now get d7_state 4\n"
text r4 "if gt now get d7_state 4\n"
global cmd uchar 1
global src uchar 65537
global out uchar 65536
global from uchar 80
global into uchar 80
global sizes ulong 3

fn select n uchar to bool
put sizes 2 1
if eq n 48
put sizes 0 len m0
put sizes 1 len r0
for i ulong len m0
put from i get m0 i
end
for i ulong len r0
put into i get r0 i
end
ret true
end
if eq n 49
put sizes 0 len m1
put sizes 1 len r1
for i ulong len m1
put from i get m1 i
end
for i ulong len r1
put into i get r1 i
end
ret true
end
if eq n 50
put sizes 0 len m2
put sizes 1 len r2
put sizes 2 4
for i ulong len m2
put from i get m2 i
end
for i ulong len r2
put into i get r2 i
end
ret true
end
if eq n 51
put sizes 0 len m3
put sizes 1 len r3
for i ulong len m3
put from i get m3 i
end
for i ulong len r3
put into i get r3 i
end
ret true
end
if eq n 52
put sizes 0 len m4
put sizes 1 len r4
for i ulong len m4
put from i get m4 i
end
for i ulong len r4
put into i get r4 i
end
ret true
end
ret false
end

fn match at ulong total ulong to bool
n = get sizes 0
if gt n sub total at
ret false
end
for i ulong n
if ne get src add at i get from i
ret false
end
end
ret true
end

fn patch total ulong to ulong
p = ulong 0
q = ulong 0
hits = ulong 0
while lt p total
if match p total
hits = add hits 1
for i ulong get sizes 1
put out q get into i
q = add q 1
end
p = add p get sizes 0
else
put out q get src p
q = add q 1
p = add p 1
end
end
if ne hits get sizes 2
ret 0
end
ret q
end

fn output n ulong to int
p = ulong 0
while lt p n
w = write 1 out p sub n p
if le w 0
ret 74
end
p = add p ulong w
end
ret 0
end

fn main to int
n = read 0 cmd 0 1
if ne n 1
ret 65
end
if not select get cmd 0
ret 65
end
total = ulong 0
more = true
while more
n = read 0 src total sub 65537 total
if lt n 0
ret 74
end
if eq n 0
more = false
end
total = add total ulong n
if gt total 65536
ret 65
end
end
nout = patch total
if eq nout 0
ret 65
end
ret output nout
end
