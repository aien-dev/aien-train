note Native IEEE binary32 addition over bit patterns, RNE and gradual underflow.
note Canonical positive quiet NaN; no foreign floating runtime or compiler f32 type.
fn ajam x ulong n ulong to ulong
if eq n 0
ret x
end
if ge n 64
if ne x 0
ret 1
end
ret 0
end
q = shr x n
mask = sub shl 1 n 1
if ne and x mask 0
q = or q 1
end
ret q
end
fn add32 aa ulong bb ulong to ulong
a = and aa 4294967295
b = and bb 4294967295
if or gt and a 2147483647 2139095040 gt and b 2147483647 2139095040
ret 2143289344
end
if lt and a 2147483647 and b 2147483647
t = a
a = b
b = t
end
if eq and a 2147483647 2139095040
if and eq and b 2147483647 2139095040 ne and xor a b 2147483648 0
ret 2143289344
end
ret a
end
if eq and b 2147483647 0
if eq and a 2147483647 0
ret and and a b 2147483648
end
ret a
end
sign = and a 2147483648
ea = and shr a 23 255
eb = and shr b 23 255
ma = and a 8388607
mb = and b 8388607
if eq ea 0
ea = 1
else
ma = or ma 8388608
end
if eq eb 0
eb = 1
else
mb = or mb 8388608
end
ma = shl ma 3
mb = shl mb 3
mb = ajam mb sub ea eb
if eq and xor a b 2147483648 0
ma = add ma mb
if ge ma 134217728
ma = ajam ma 1
ea = add ea 1
end
else
ma = sub ma mb
if eq ma 0
ret 0
end
while and lt ma 67108864 gt ea 1
ma = shl ma 1
ea = sub ea 1
end
end
q = shr ma 3
r = and ma 7
if gt r 4
q = add q 1
else
if eq r 4
if ne and q 1 0
q = add q 1
end
end
end
if ge q 16777216
q = shr q 1
ea = add ea 1
end
if ge ea 255
ret or sign 2139095040
end
if lt q 8388608
ea = 0
end
q = and q 8388607
ea = shl ea 23
q = or q ea
ret or sign q
end
note SPDX-License-Identifier: AGPL-3.0-only
global failed ulong 1
global tested ulong 1
global line uchar 48
fn report ok bool to void
id = add get tested 0 1
put tested 0 id
put line 0 48
put line 1 uchar add 48 rem div id 100 10
put line 2 uchar add 48 rem div id 10 10
put line 3 uchar add 48 rem id 10
put line 4 32
put line 5 48
if not ok
put line 5 49
put failed 0 add get failed 0 1
end
put line 6 10
w = write 1 line 0 7
if ne w 7
exit 74
end
end
note Native addition corpus runner; each record a,b,expected binary32 LE bits.
global record uchar 12
fn aword p ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get record add p i mul i 8
end
ret v
end
fn main to int
while true
p = ulong 0
while lt p 12
n = read 0 record p sub 12 p
if eq n 0
if ne p 0
ret 74
end
if ne get failed 0 0
ret 1
end
ret 0
end
if eq n -4
n = 0
else
if lt n 0
ret 74
end
end
p = add p ulong n
end
a = aword 0
b = aword 4
wanted = aword 8
report eq add32 a b wanted
end
ret 0
end
