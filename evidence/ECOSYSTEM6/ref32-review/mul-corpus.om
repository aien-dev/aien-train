note SPDX-License-Identifier: AGPL-3.0-only
note Native IEEE binary32 multiplication represented as bits; no host floating runtime.
note Round-to-nearest ties-to-even, gradual underflow, signed zeros and infinities.
note Canonical positive quiet NaN for every NaN result. Inputs are low32 bits.
fn mround x ulong shift ulong to ulong
if eq shift 0
ret x
end
if gt shift 63
ret 0
end
q = shr x shift
mask = sub shl 1 shift 1
r = and x mask
half = shl 1 sub shift 1
if or gt r half and eq r half ne and q 1 0
q = add q 1
end
ret q
end
fn mul32 aa ulong bb ulong to ulong
a = and aa 4294967295
b = and bb 4294967295
sign = and xor a b 2147483648
ea = long and shr a 23 255
eb = long and shr b 23 255
ma = and a 8388607
mb = and b 8388607
if or and eq ea 255 ne ma 0 and eq eb 255 ne mb 0
ret 2143289344
end
if or eq ea 255 eq eb 255
if or eq and a 2147483647 0 eq and b 2147483647 0
ret 2143289344
end
ret or sign 2139095040
end
if or eq and a 2147483647 0 eq and b 2147483647 0
ret sign
end
if eq ea 0
ea = 1
while lt ma 8388608
ma = shl ma 1
ea = sub ea 1
end
else
ma = or ma 8388608
end
if eq eb 0
eb = 1
while lt mb 8388608
mb = shl mb 1
eb = sub eb 1
end
else
mb = or mb 8388608
end
product = mul ma mb
e = sub add ea eb 127
shift = long 23
if ge product 140737488355328
shift = 24
e = add e 1
end
if lt e 1
shift = add shift sub 1 e
e = 0
end
q = mround product ulong shift
if eq e 0
if ge q 8388608
e = 1
end
else
if ge q 16777216
q = shr q 1
e = add e 1
end
end
if ge e 255
ret or sign 2139095040
end
q = and q 8388607
e = shl e 23
q = or q ulong e
ret or sign q
end
note SPDX-License-Identifier: AGPL-3.0-only
global failed ulong 1
global tested ulong 1
global line uchar 48
fn report ok bool to void
id = add get tested 0 1
put tested 0 id
put line 0 48
put line 1 uchar add 48 rem div id 100 10
put line 2 uchar add 48 rem div id 10 10
put line 3 uchar add 48 rem id 10
put line 4 32
put line 5 48
if not ok
put line 5 49
put failed 0 add get failed 0 1
end
put line 6 10
w = write 1 line 0 7
if ne w 7
exit 74
end
end
note Native corpus runner. Each record is a,b,expected IEEE binary32 LE bits.
global record uchar 12
fn mword p ulong to ulong
v = ulong 0
for i ulong 4
v = or v shl ulong get record add p i mul i 8
end
ret v
end
fn main to int
while true
p = ulong 0
while lt p 12
n = read 0 record p sub 12 p
if eq n 0
if ne p 0
ret 74
end
if ne get failed 0 0
ret 1
end
ret 0
end
if eq n -4
n = 0
else
if lt n 0
ret 74
end
end
p = add p ulong n
end
a = mword 0
b = mword 4
wanted = mword 8
report eq mul32 a b wanted
end
ret 0
end
