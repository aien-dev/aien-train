fn loc p ulong to ulong
if lt p 6
ret p
end
if lt p 12
ret add p 10
end
ret add p 20
end

fn dim t ulong rank ulong a ulong b ulong to void
d = mul t 24
s = mul t 8
n = mul a b
put AD d 1
put AD add d 1 1
put AD add d 2 rank
put AD add d 3 n
put AD add d 5 add t 1
put AD add d 6 add t 9
put AD add d 8 a
put AD add d 16 b
if eq rank 2
put AD add d 9 b
put AD add d 17 1
end
put AS s 1
put AS add s 2 add t 1
put AS add s 3 add t 9
put AS add s 4 1
put AS add s 5 n
end

fn init to void
for i ulong 192
put AD i 0
end
for i ulong 64
put AS i 0
end
for i ulong 128
put AP i 2143289344
end
put AL 0 1092616192
dim 0 2 2 3
dim 1 2 3 2
dim 2 1 2 1
dim 3 2 2 2
dim 4 2 2 2
dim 5 2 2 3
dim 6 2 3 2
dim 7 1 2 1
for p ulong 14
put AP loc p get BI p
end
put AP 48 1048576000
put AP 49 1065353216
put AP 50 3212836864
put AP 51 1056964608
end

fn freeze to void
for i ulong 128
put OLD i get AP i
end
put OLD 128 get AL 0
end

fn same to void
for i ulong 128
chk eq get OLD i get AP i
end
chk eq get OLD 128 get AL 0
end

fn grads to void
for i ulong 6
chk eq get AP add 80 i get GI i
chk eq get AP add 96 i get GI add i 6
end
chk eq get AP 112 get GI 12
chk eq get AP 113 get GI 13
end

fn one to void
init
chk eq afstep 1023410176 0
chk eq get AP 64 3224895488
chk eq get AP 65 1081081856
chk eq get AP 66 1070596096
chk eq get AP 67 3225419776
chk eq get AL 0 1108467712
grads
chk eq get AP 16 1052508160
chk eq get AP 17 1015021568
chk eq get AP 18 1058799616
chk eq get AP 19 1066139648
chk eq get AP 20 1048576000
chk eq get AP 21 1067581440
chk eq get AP 32 1042284544
chk eq get AP 33 3202875392
for i ulong 6
chk eq get AP i get BI i
end
chk eq get AP 48 1048576000
chk eq get AP 49 1065353216
chk eq get AP 50 3212836864
chk eq get AP 51 1056964608
note Non-tensor padding must remain unchanged by the fixed-slot commit.
for t ulong 8
chk eq get AP add mul t 16 15 2143289344
end
end

fn central to void
for p ulong 14
init
put AP loc p get PI p
chk eq afstep 0 0
hi = get AL 0
chk eq hi get PL p
init
put AP loc p get MI p
chk eq afstep 0 0
lo = get AL 0
chk eq lo get ML p
note Expected loss difference is a literal from symbolic exact arithmetic.
chk eq add32 hi xor lo 2147483648 get DL p
end
init
chk eq afstep 0 0
grads
freeze
chk eq afstep 0 0
same
end

fn reject to void
init
put AD 8 3
put AD 9 2
put AD 16 2
freeze
chk eq afstep 0 -21
same
init
put AD 6 0
freeze
chk eq afstep 0 -5
same
init
put AS 3 10
freeze
chk eq afstep 0 -5
same
init
freeze
chk eq afstep 2147483648 -22
same
init
put AP 17 2143289344
freeze
chk eq afstep 0 -22
same
init
put AP 0 2139095039
put AP 16 2139095039
freeze
chk eq afstep 0 -23
same
end

fn main to int
tables
one
central
reject
w = write 1 OK 0 len OK
dec get NC 0
w = write 1 EOL 0 1
ret 0
end
