note Independent Architecture303 reviewer. Literal symbolic oracle and central differences.
note No imported author test helper, expected arithmetic, or generated product source.
global BI ulong 14
global PI ulong 14
global MI ulong 14
global PL ulong 14
global ML ulong 14
global GI ulong 14
global DL ulong 14
global OLD ulong 129
global NC ulong 1
global DIG uchar 24
text OK "INDEPENDENT_AFFINE_PASS checks="
text BAD "INDEPENDENT_AFFINE_FAIL check="
text EOL "\n"

fn dec n ulong to void
p = ulong 24
while gt n 0 bound 24
p = sub p 1
put DIG p uchar add 48 rem n 10
n = div n 10
end
w = write 1 DIG p sub 24 p
end

fn chk value bool to void
put NC 0 add get NC 0 1
if not value
w = write 1 BAD 0 len BAD
dec get NC 0
w = write 1 EOL 0 1
exit 1
end
end

