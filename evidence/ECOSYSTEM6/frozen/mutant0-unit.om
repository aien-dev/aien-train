note SPDX-License-Identifier: AGPL-3.0-only
note Native IEEE binary32 addition over bit patterns, RNE and gradual underflow.
note Canonical positive quiet NaN; no foreign floating runtime or compiler f32 type.
fn ajam x ulong n ulong to ulong
if eq n 0
ret x
end
if ge n 64
if ne x 0
ret 1
end
ret 0
end
q = shr x n
mask = sub shl 1 n 1
if ne and x mask 0
q = or q 1
end
ret q
end
fn add32 aa ulong bb ulong to ulong
a = and aa 4294967295
b = and bb 4294967295
if or gt and a 2147483647 2139095040 gt and b 2147483647 2139095040
ret 2143289344
end
if lt and a 2147483647 and b 2147483647
t = a
a = b
b = t
end
if eq and a 2147483647 2139095040
if and eq and b 2147483647 2139095040 ne and xor a b 2147483648 0
ret 2143289344
end
ret a
end
if eq and b 2147483647 0
if eq and a 2147483647 0
ret and and a b 2147483648
end
ret a
end
sign = and a 2147483648
ea = and shr a 23 255
eb = and shr b 23 255
ma = and a 8388607
mb = and b 8388607
if eq ea 0
ea = 1
else
ma = or ma 8388608
end
if eq eb 0
eb = 1
else
mb = or mb 8388608
end
ma = shl ma 3
mb = shl mb 3
mb = ajam mb sub ea eb
if eq and xor a b 2147483648 0
ma = add ma mb
if ge ma 134217728
ma = ajam ma 1
ea = add ea 1
end
else
ma = sub ma mb
if eq ma 0
ret 0
end
while and lt ma 67108864 gt ea 1
ma = shl ma 1
ea = sub ea 1
end
end
q = shr ma 3
r = and ma 7
if gt r 4
q = add q 1
else
if eq r 4
if ne and q 1 0
q = add q 1
end
end
end
if ge q 16777216
q = shr q 1
ea = add ea 1
end
if ge ea 255
ret or sign 2139095040
end
if lt q 8388608
ea = 0
end
q = and q 8388607
ea = shl ea 23
q = or q ea
ret or sign q
end
note SPDX-License-Identifier: AGPL-3.0-only
note Native IEEE binary32 multiplication represented as bits; no host floating runtime.
note Round-to-nearest ties-to-even, gradual underflow, signed zeros and infinities.
note Canonical positive quiet NaN for every NaN result. Inputs are low32 bits.
fn mround x ulong shift ulong to ulong
if eq shift 0
ret x
end
if gt shift 63
ret 0
end
q = shr x shift
mask = sub shl 1 shift 1
r = and x mask
half = shl 1 sub shift 1
if or gt r half and eq r half ne and q 1 0
q = add q 1
end
ret q
end
fn mul32 aa ulong bb ulong to ulong
a = and aa 4294967295
b = and bb 4294967295
sign = and xor a b 2147483648
ea = long and shr a 23 255
eb = long and shr b 23 255
ma = and a 8388607
mb = and b 8388607
if or and eq ea 255 ne ma 0 and eq eb 255 ne mb 0
ret 2143289344
end
if or eq ea 255 eq eb 255
if or eq and a 2147483647 0 eq and b 2147483647 0
ret 2143289344
end
ret or sign 2139095040
end
if or eq and a 2147483647 0 eq and b 2147483647 0
ret sign
end
if eq ea 0
ea = 1
while lt ma 8388608
ma = shl ma 1
ea = sub ea 1
end
else
ma = or ma 8388608
end
if eq eb 0
eb = 1
while lt mb 8388608
mb = shl mb 1
eb = sub eb 1
end
else
mb = or mb 8388608
end
product = mul ma mb
e = sub add ea eb 127
shift = long 23
if ge product 140737488355328
shift = 24
e = add e 1
end
if lt e 1
shift = add shift sub 1 e
e = 0
end
q = mround product ulong shift
if eq e 0
if ge q 8388608
e = 1
end
else
if ge q 16777216
q = shr q 1
e = add e 1
end
end
if ge e 255
ret or sign 2139095040
end
q = and q 8388607
e = shl e 23
q = or q ulong e
ret or sign q
end
note M20 metadata-v1. Integer metadata only; no allocator or numeric execution.
note ED: schema,dtype,rank,elements,offset,slot,generation,reserved,shape8,stride8.
note ES: live,retired,slot,generation,dtype,elements,reserved,reserved.
note ES is the caller-owned allocator snapshot. It is not untrusted wire input.
global ED ulong 24
global ES ulong 8

fn emshape to int
rank = get ED 2
if gt rank 8
ret -2
end
n = ulong 1
for d ulong rank
size = get ED add 8 d
if eq size 0
ret -3
end
if gt size div 1073741824 n
ret -8
end
n = mul n size
end
if ne get ED 3 n
ret -3
end
ret 0
end

fn emlive slot ulong gen ulong to int
if gt slot 4294967295
ret -5
end
if or ne get ES 0 1 ne get ES 1 0
ret -5
end
if or eq gen 0 ne slot get ES 2
ret -5
end
if ne gen get ES 3
ret -5
end
ret 0
end

fn embounds to int
size = get ES 5
offset = get ED 4
if or eq size 0 gt size 1073741824
ret -8
end
if ge offset size
ret -6
end
note Compare against remaining extent before multiplication, never overflow.
room = sub sub size 1 offset
for d ulong get ED 2
count = sub get ED add 8 d 1
stride = get ED add 16 d
if ne stride 0
if gt count div room stride
ret -6
end
room = sub room mul count stride
end
end
ret 0
end

fn emcheck to int
if or ne get ED 0 1 ne get ED 7 0
ret -1
end
if or ne get ES 6 0 ne get ES 7 0
ret -1
end
dtype = get ED 1
if or lt dtype 1 gt dtype 3
ret -4
end
status = emshape
if ne status 0
ret status
end
status = emlive get ED 5 get ED 6
if ne status 0
ret status
end
if ne dtype get ES 4
ret -4
end
ret embounds
end

fn emrelease slot ulong gen ulong to int
status = emlive slot gen
if ne status 0
ret status
end
note A maximal generation is retired, never wrapped into a valid old handle.
if eq gen 18446744073709551615
put ES 1 1
else
put ES 3 add gen 1
end
put ES 0 0
ret 0
end
note SPDX-License-Identifier: AGPL-3.0-only
note Bounded host FP32 consumer. Uses external pinned L720 add32/mul32 and M20 emcheck.
note Eight independent tensors X,W,b,T,Y,dX,dW,db in 16-cell slots.
note Values are IEEE binary32 bits in ulong carriers, not integer fixed-point values.
note AD/AS are trusted local descriptor and allocator snapshots, not wire records.
global AD ulong 192
global AS ulong 64
global AP ulong 128
global AQ ulong 128
global AL ulong 1

fn afcount t ulong to ulong
if or eq t 2 eq t 7
ret 2
end
if or eq t 3 eq t 4
ret 4
end
ret 6
end

fn afget t ulong i ulong to ulong
ret get AP add mul t 16 i
end

fn afq t ulong i ulong to ulong
ret get AQ add mul t 16 i
end

fn afput t ulong i ulong v ulong to void
put AQ add mul t 16 i v
end

fn affinite x ulong to bool
if gt x 4294967295
ret false
end
ret lt and x 2147483647 2139095040
end

fn afvalidate to int
for t ulong 8
for i ulong 24
put ED i get AD add mul t 24 i
end
for i ulong 8
put ES i get AS add mul t 8 i
end
status = emcheck
if ne status 0
ret status
end
note Contiguous owned local carriers only. This does not claim strided numeric kernels.
if or ne get ED 1 1 ne get ED 4 0
ret -20
end
if or ne get ED 5 add t 1 ne get ES 5 afcount t
ret -20
end
rank = ulong 2
rows = ulong 2
cols = ulong 3
if or eq t 1 eq t 6
rows = 3
cols = 2
end
if or eq t 3 eq t 4
cols = 2
end
if or eq t 2 eq t 7
rank = 1
cols = 1
end
if or ne get ED 2 rank ne get ED 8 rows
ret -21
end
if ne get ED 16 cols
ret -21
end
if eq rank 2
if or ne get ED 9 cols ne get ED 17 1
ret -21
end
end
end
ret 0
end

fn afstep lr ulong to int
status = afvalidate
if ne status 0
ret status
end
if not affinite lr
ret -22
end
if ne and lr 2147483648 0
ret -22
end
for t ulong 4
for i ulong afcount t
if not affinite afget t i
ret -22
end
end
end
for i ulong 128
put AQ i 0
end
loss = ulong 0
for row ulong 2
for col ulong 2
v = afget 2 col
for k ulong 3
x = afget 0 add mul row 3 k
w = afget 1 add mul k 2 col
v = add32 v mul32 x w
end
pos = add mul row 2 col
afput 4 pos v
r = add32 v xor afget 3 pos 2147483648
loss = add32 loss mul32 r r
g = mul32 3221225472 r
afput 7 col add32 afq 7 col g
for k ulong 3
xp = add mul row 3 k
wp = add mul k 2 col
gx = mul32 g afget 1 wp
gw = mul32 g afget 0 xp
afput 5 xp add32 afq 5 xp gx
afput 6 wp add32 afq 6 wp gw
end
end
end
note Commit only after all finite-result checks; rejected steps preserve AP and AL.
for i ulong 6
delta = mul32 lr afq 6 i
afput 1 i add32 afget 1 i xor delta 2147483648
end
for i ulong 2
delta = mul32 lr afq 7 i
afput 2 i add32 afget 2 i xor delta 2147483648
end
if not affinite loss
ret -23
end
for t ulong 8
if and ne t 0 ne t 3
for i ulong afcount t
if not affinite afq t i
ret -23
end
end
end
end
for t ulong 8
if and ne t 0 ne t 3
for i ulong afcount t
put AP add mul t 16 i afq t i
end
end
end
put AL 0 loss
ret 0
end
note SPDX-License-Identifier: AGPL-3.0-only
note Independent exact rational oracle: X/8,W/16,b/128,T/128,learning rate1/32.
note Only the test oracle uses integer rationals. Production calls IEEE add32/mul32.
global C ulong 1
global D uchar 24
global RI long 18
global RR long 4
global SAV ulong 129
global RNG ulong 1
text PASS "NATIVE_AFFINE_FP32_PASS checks="
text FAIL "NATIVE_AFFINE_FP32_FAIL check="
text NL "\n"

fn number n ulong to void
if eq n 0
put D 0 48
w = write 1 D 0 1
if ne w 1
exit 90
end
ret
end
p = ulong 24
while gt n 0 bound 24
p = sub p 1
put D p uchar add 48 rem n 10
n = div n 10
end
w = write 1 D p sub 24 p
if ne w long sub 24 p
exit 90
end
end

fn check ok bool to void
put C 0 add get C 0 1
if not ok
w = write 1 FAIL 0 len FAIL
number get C 0
w = write 1 NL 0 1
exit 1
end
end

fn bits value long scale ulong to ulong
note Exact binary32 encoding of small dyadic test numbers; no production primitive.
if eq value 0
ret 0
end
sign = ulong 0
if lt value 0
sign = 2147483648
value = neg value
end
n = ulong value
power = ulong 0
q = n
while gt q 1 bound 24
q = shr q 1
power = add power 1
end
check le power 23
mantissa = sub shl n sub 23 power 8388608
exponent = sub add power 127 scale
ret or sign or shl exponent 23 mantissa
end

fn fixture to void
for i ulong 192
put AD i 0
end
for i ulong 64
put AS i 0
end
for i ulong 128
put AP i 0
end
put AL 0 0
for t ulong 8
rank = ulong 2
rows = ulong 2
cols = ulong 3
count = ulong 6
if or eq t 1 eq t 6
rows = 3
cols = 2
end
if or eq t 3 eq t 4
cols = 2
count = 4
end
if or eq t 2 eq t 7
rank = 1
cols = 1
count = 2
end
p = mul t 24
put AD p 1
put AD add p 1 1
put AD add p 2 rank
put AD add p 3 count
put AD add p 5 add t 1
put AD add p 6 17
put AD add p 8 rows
put AD add p 16 cols
if eq rank 2
put AD add p 9 cols
put AD add p 17 1
end
p = mul t 8
put AS p 1
put AS add p 2 add t 1
put AS add p 3 17
put AS add p 4 1
put AS add p 5 count
end
end

fn save to void
for i ulong 128
put SAV i get AP i
end
put SAV 128 get AL 0
end

fn unchanged to void
for i ulong 128
check eq get SAV i get AP i
end
check eq get SAV 128 get AL 0
end

fn loadinputs to void
for i ulong 6
put AP i bits get RI i 3
put AP add 16 i bits get RI add 6 i 4
end
for i ulong 2
put AP add 32 i bits get RI add 12 i 7
end
for i ulong 4
put AP add 48 i bits get RI add 14 i 7
end
end

fn oracle to void
loss = long 0
for row ulong 2
for col ulong 2
pos = add mul row 2 col
y = get RI add 12 col
for k ulong 3
x = get RI add mul row 3 k
w = get RI add 6 add mul k 2 col
y = add y mul x w
end
check eq afget 4 pos bits y 7
r = sub y get RI add 14 pos
put RR pos r
loss = add loss mul r r
end
end
check eq get AL 0 bits loss 14
for k ulong 3
for col ulong 2
g = long 0
for row ulong 2
r = get RR add mul row 2 col
x = get RI add mul row 3 k
g = add g mul r x
end
pos = add mul k 2 col
check eq afget 6 pos bits g 9
updated = sub mul get RI add 6 pos 1024 g
check eq afget 1 pos bits updated 14
end
end
for col ulong 2
g = add get RR col get RR add 2 col
check eq afget 7 col bits g 6
updated = sub mul get RI add 12 col 16 g
check eq afget 2 col bits updated 11
end
for row ulong 2
for k ulong 3
g = long 0
for col ulong 2
r = get RR add mul row 2 col
w = get RI add 6 add mul k 2 col
g = add g mul r w
end
pos = add mul row 3 k
check eq afget 5 pos bits g 10
end
end
note Inputs and targets remain byte-identical after a successful step.
for i ulong 6
check eq afget 0 i bits get RI i 3
end
for i ulong 4
check eq afget 3 i bits get RI add 14 i 7
end
end

fn direct to void
fixture
check eq afvalidate 0
note X rows(1,-2,3),(2,0,-1); W(.5,-.25),(1,.75),(-.5,2).
put RI 0 8
put RI 1 -16
put RI 2 24
put RI 3 16
put RI 4 0
put RI 5 -8
put RI 6 8
put RI 7 -4
put RI 8 16
put RI 9 12
put RI 10 -8
put RI 11 32
put RI 12 16
put RI 13 -64
put RI 14 32
put RI 15 128
put RI 16 -128
put RI 17 64
loadinputs
check eq afstep 1023410176 0
oracle
note Independently hand-calculated loss36.46875, not merely decreasing loss.
check eq get AL 0 1108467712
end

fn refusals to void
fixture
put AD 32 2
put AD 33 3
put AD 40 3
save
check eq afstep 1023410176 -21
unchanged
fixture
put AS 11 18
save
check eq afstep 1023410176 -5
unchanged
fixture
put AD 29 1
put AS 10 1
save
check eq afstep 1023410176 -20
unchanged
fixture
put AP 0 2139095040
save
check eq afstep 1023410176 -22
unchanged
fixture
put AP 0 2143289344
save
check eq afstep 1023410176 -22
unchanged
fixture
put AP 0 4294967296
save
check eq afstep 1023410176 -22
unchanged
fixture
save
check eq afstep 3170893824 -22
unchanged
fixture
put AP 0 2139095039
put AP 16 1073741824
save
check eq afstep 1023410176 -23
unchanged
end

fn next to long
n = add mul get RNG 0 1664525 1013904223
n = and n 4294967295
put RNG 0 n
ret sub long rem shr n 12 17 8
end

fn rounding to void
note Smallest subnormal through actual forward and input derivative, loss underflows.
fixture
put AP 0 1
put AP 16 1065353216
check eq afstep 0 0
check eq afget 4 0 1
check eq afget 5 0 2
check eq afget 6 0 0
check eq afget 7 0 2
check eq get AL 0 0
note Half a subnormal rounds to even zero.
fixture
put AP 0 1
put AP 16 1056964608
check eq afstep 0 0
check eq afget 4 0 0
note 1 + 2^-24 rounds to even1; 1 + 3*2^-24 rounds upward two ulps.
fixture
put AP 0 1065353216
put AP 16 1065353216
put AP 32 864026624
check eq afstep 0 0
check eq afget 4 0 1065353216
check eq afget 1 0 1065353216
fixture
put AP 0 1065353216
put AP 16 1065353216
put AP 32 876609536
check eq afstep 0 0
check eq afget 4 0 1065353218
end

fn corpus to void
put RNG 0 303660
for trial ulong 4096
fixture
for i ulong 18
put RI i next
end
loadinputs
check eq afstep 1023410176 0
oracle
end
end

fn main to int
direct
refusals
rounding
corpus
w = write 1 PASS 0 len PASS
number get C 0
w = write 1 NL 0 1
if ne w 1
ret 90
end
ret 0
end
