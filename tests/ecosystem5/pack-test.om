put DPToken 0 1024
refused 75
put DPToken 0 1
put DPLen 0 253
refused 76
put DPLen 0 4
put DPLen 63 1
refused 73
put DPLen 63 0
put DPCfg 1 4294967297
refused 71
put DPCfg 1 1024
put DPCfg 3 1024
refused 71
put DPCfg 3 0
put CGood 0 64
refused 73
put CGood 0 0
for i ulong 4
put DPPin i 0
put DPPin add i 4 0
end
refused 72
for i ulong 4
put DPPin i add i 1
put DPPin add i 4 add i 1
put DPPin add i 8 0
put DPPin add i 12 0
end
refused 72
setup 2
ck cbegin 2 10000 0
submit 1 0
submit 0 0
ck cfinish 0
put DPLen 0 1
put DPLen 1 1
ck dppack 0
ck get DPTask 0 1
ck get DPTask 1 0
ck get DPOut 0 257
ck get DPOut 1 1
ck attention 1 0 0
note Live manifest edits cannot change frozen admitted split or source identity.
put LT 1 2
ck dppack 0
setup 2
put LT 33 2
ck cbegin 2 10000 0
submit 0 0
submit 1 0
ck cfinish 0
put DPLen 0 1
put DPLen 1 1
save
refused 77
admitted 1
put DPLen 0 256
put DPPrompt 0 0
ck dppack 0
ck get DPState 1 256
ck get DPMask 254 1
ck get DPMask 255 0
ck attention 255 0 1
ck attention 256 0 0
ck attention 18446744073709551615 0 0
admitted 64
ck dppack 0
ck get DPState 1 128
ck get DPState 2 64
ck get DPTask 127 63
setup 2
ck cbegin 2 10000 0
submit 0 1
submit 1 0
ck cfinish 0
put DPLen 1 3
put DPPrompt 1 1
