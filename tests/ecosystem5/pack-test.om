setup 1
ck cbegin 1 10000 0
submit 0 1
ck cfinish 0
ck dppack 0
ck get DPState 1 0
ck get DPState 2 0
ck attention 0 0 0
w = write 1 Pass 0 11
number get Checks 0
w = write 1 NL 0 1
ret 0
end
