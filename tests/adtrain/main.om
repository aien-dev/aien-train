note SPDX-License-Identifier: AGPL-3.0-only
note adtrain driver. Reads one mode byte from fd 0:
note T train 200 steps (L rows, P rows, loss gate 88), S train 120 and save,
note R load and continue to 200, Z as S with data seed 29, G tape gradients
note against central differences, D write the C-oracle fixture and K rows.
note Exits: 90 bad mode, 65 corrupt checkpoint, 66 data-binding mismatch,
note 88 loss not reduced, 1 gradient check failed; mlp.om adds 74/86/87.
global AD uchar 24
global AB uchar 4
global AC ulong 2
global AL f32 1
text ATP "ADTRAIN_T_PASS\n"
text ASP "ADTRAIN_S_PASS\n"
text ARP "ADTRAIN_R_PASS\n"
text AGP "ADTRAIN_G_PASS checked="
text AGF "ADTRAIN_G_FAIL checked="
text ADP "ADTRAIN_D_PASS\n"
text ASK "skip"
text AFL " failed="

fn dout t uchar to void
put AB 0 t
w = write 1 AB 0 1
if ne w 1
exit 74
end
end

fn dnum n ulong to void
if eq n 0
dout 48
ret
end
p = ulong 24
while gt n 0 bound 24
p = sub p 1
put AD p uchar add 48 rem n 10
n = div n 10
end
w = write 1 AD p sub 24 p
if ne w long sub 24 p
exit 74
end
end

fn dtext n ulong to void
note n selects one of the fixed texts.
if eq n 0
w = write 1 ATP 0 len ATP
end
if eq n 1
w = write 1 ASP 0 len ASP
end
if eq n 2
w = write 1 ARP 0 len ARP
end
if eq n 3
w = write 1 ADP 0 len ADP
end
end

note "<tag> <a> <b>\n"
fn dline tag uchar a ulong b ulong to void
dout tag
dout 32
dnum a
dout 32
dnum b
dout 10
end

fn dloss s ulong l f32 to void
dline 76 s mlbits l
end

fn dparams to void
for i ulong 58
dline 80 i mlbits get MP i
end
end

note Train from the current step up to `upto`, printing L rows, then L upto.
note The loss at step 100 is kept in AL for the T loss gate.
fn dtrain upto ulong to f32
start = get MS 1
for i ulong sub upto start
s = add start i
l = mlstep
dloss s l
if eq s 100
put AL 0 l
end
end
l = mlfwd
dloss upto l
ret l
end

fn mode_t to void
mlinit 17
l0 = mlfwd
l200 = dtrain 200
if not and lt l200 l0 lt l200 get AL 0
exit 88
end
dparams
dtext 0
end

fn mode_s seed ulong to void
mlinit seed
l = dtrain 120
cksave l
dtext 1
end

fn mode_r to void
mlinit 17
st = ckload
if eq st -1
exit 65
end
if eq st -2
exit 66
end
if ne st 0
exit 65
end
l = dtrain 200
dparams
dtext 2
end

note One central difference; returns 0 skipped, 1 agreed, 2 disagreed.
fn dgc i ulong to ulong
p = get MP i
eps = mllr
put MP i add p eps
fp = mlfwd
okp = mlsame
put MP i sub p eps
fm = mlfwd
okm = mlsame
put MP i p
dout 71
dout 67
dout 32
dnum i
dout 32
if not and okp okm
w = write 1 ASK 0 len ASK
dout 10
ret 0
end
d = mul sub fp fm 32.0f32
g = get MG i
e = fabs sub d g
ok = le e eps
if ge fabs g eps
ok = le mul e 16.0f32 fabs g
end
dnum mlbits d
dout 32
if ok
dout 49
dout 10
ret 1
end
dout 48
dout 10
ret 2
end

fn mode_g to void
mlinit 17
l = mlgrad
mlmask
for i ulong 58
dline 71 i mlbits get MG i
end
put AC 0 0
put AC 1 0
for i ulong 58
r = dgc i
if eq r 1
put AC 0 add get AC 0 1
end
if eq r 2
put AC 1 add get AC 1 1
end
end
ok = and ge get AC 0 50 eq get AC 1 0
if ok
w = write 1 AGP 0 len AGP
else
w = write 1 AGF 0 len AGF
end
dnum add get AC 0 get AC 1
w = write 1 AFL 0 len AFL
dnum get AC 1
dout 10
if not ok
exit 1
end
end

note K rows: the first ten generator values k (-8..8) of seed 17, for an
note external re-implementation of the data generator.
fn mode_d to void
mlinit 17
l = mlgrad
mlfix
put MS 0 17
for i ulong 10
k = mlk
dout 75
dout 32
dnum i
dout 32
if lt k 0
dout 45
k = neg k
end
dnum ulong k
dout 10
end
dtext 3
end

fn main to int
n = read 0 AB 0 1
if ne n 1
exit 90
end
m = get AB 0
if eq m 84
mode_t
ret 0
end
if eq m 83
mode_s 17
ret 0
end
if eq m 90
mode_s 29
ret 0
end
if eq m 82
mode_r
ret 0
end
if eq m 71
mode_g
ret 0
end
if eq m 68
mode_d
ret 0
end
exit 90
end
